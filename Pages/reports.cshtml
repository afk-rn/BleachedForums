@page
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bleached Forums - Reports</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-dark {
            background-color: #1e252b;
        }
        .card {
            border: none;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }
        /* Custom stylings to match the PDF color blocks precisely */
        .metric-card {
            border-radius: 6px;
            padding: 1.5rem 1rem;
            color: white;
            text-align: center;
        }
        .metric-title {
            font-size: 0.9rem;
            opacity: 0.9;
            margin-bottom: 0.5rem;
        }
        .metric-value {
            font-size: 2rem;
            font-weight: 700;
        }
        .bg-custom-blue {
            background-color: #0d6efd;
        }
        .bg-custom-yellow {
            background-color: #ffc107;
            color: #212529; /* Dark text for yellow readability */
        }
        .bg-custom-green {
            background-color: #198754;
        }
        .bg-custom-red {
            background-color: #dc3545;
        }
        .table th {
            font-weight: 600;
            color: #495057;
            border-bottom-width: 1px;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="dashboard">Bleached Forums</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="dashboard">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="reports">Reports</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" aria-current="page" href="user-management">User Management</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="about">About</a>
                    </li>
                </ul>
                <a href="login" class="btn btn-outline-light btn-sm ms-3">
                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                </a>
            </div>
        </div>
    </nav>

    <div class="container my-5 flex-grow-1">
        <div class="row mb-4">
            <div class="col-12">
                <h1 class="fw-normal text-dark">System Reports</h1>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="metric-card bg-custom-blue">
                    <div class="metric-title">Total Users</div>
                    <div class="metric-value">1,240</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-card bg-custom-yellow">
                    <div class="metric-title">Pending Tickets</div>
                    <div class="metric-value">14</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-card bg-custom-green">
                    <div class="metric-title">Total Posts</div>
                    <div class="metric-value">5,602</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-card bg-custom-red">
                    <div class="metric-title">Flagged Posts</div>
                    <div class="metric-value">8</div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card p-4 h-100">
                    <h5 class="fw-bold mb-4 text-dark fs-6">Recent Support Tickets</h5>
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Type</th>
                                    <th>Priority</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-muted">#882</td>
                                    <td>Technical</td>
                                    <td><span class="text-danger">High</span></td>
                                    <td><span class="badge bg-primary text-white">Open</span></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">#881</td>
                                    <td>Billing</td>
                                    <td><span class="text-muted">Low</span></td>
                                    <td><span class="badge bg-secondary text-white">Closed</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card p-4 h-100">
                    <h5 class="fw-bold mb-4 text-dark fs-6">User Status Distribution</h5>
                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Active Users</span>
                            <span class="badge rounded-pill bg-success px-3 py-2">1,150</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Suspended</span>
                            <span class="badge rounded-pill bg-warning text-dark px-3 py-2">65</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Banned</span>
                            <span class="badge rounded-pill bg-danger px-3 py-2">25</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
