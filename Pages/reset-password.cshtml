@page
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bleached Forums - Reset Password</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .auth-container {
            max-width: 400px;
            width: 100%;
            margin: auto;
            padding: 20px;
        }
        .card {
            border: none;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }
    </style>
</head>
<body>

    <div class="container my-4 flex-grow-1 d-flex flex-column justify-content-center">
        <div class="auth-container">
            <div class="card p-4">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-dark">Reset Password</h2>
                    <p class="text-muted small">Enter your details to update your password</p>
                </div>
                
                <form onsubmit="handleReset(event)">
		    <div class="mb-3">
			<label for="identifier" class="form-label fw-semibold">Email or Username</label>
			<input type="text" id="identifier" class="form-control" placeholder="Enter your identifier" required>
		    </div>
		    <div class="mb-3">
			<label for="newPassword" class="form-label fw-semibold">New Password</label>
			<input type="password" id="newPassword" class="form-control" placeholder="••••••••" required>
		    </div>
		    <div class="mb-3">
			<label for="confirmPassword" class="form-label fw-semibold">Confirm New Password</label>
			<input type="password" id="confirmPassword" class="form-control" placeholder="••••••••" required>
		    </div>
		    
		    <div id="statusAlert" class="alert d-none py-2 mb-3 small" role="alert"></div>

		    <div class="d-grid mb-3">
			<button type="submit" class="btn btn-primary">Update Password</button>
		    </div>
		    <div class="text-center">
			<a href="login" class="text-decoration-none small text-secondary">
			    <i class="bi bi-arrow-left"></i> Back to Login
			</a>
		    </div>
		</form>

		<script>
		// Load users when page opens
document.addEventListener('DOMContentLoaded', loadUsers);

async function loadUsers() {
    const response = await fetch('/api/users');
    const users = await response.json();
    const tbody = document.querySelector('tbody');
    tbody.innerHTML = ''; // Clear hardcoded rows

    users.forEach(user => {
        tbody.innerHTML += `
            <tr>
                <td class="fw-bold text-muted">#${user.userID}</td>
                <td class="fw-semibold">${user.username}</td>
                <td>${user.email}</td>
                <td><span class="badge bg-primary-subtle text-primary">${user.role}</span></td>
                <td><span class="badge ${getStatusClass(user.status)}">${user.status}</span></td>
                <td class="text-end">
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary" onclick="populateEditModal(${user.userID}, '${user.username}', '${user.email}', '${user.role}', '${user.status}')" data-bs-toggle="modal" data-bs-target="#editUserModal">Edit</button>
                        <button class="btn btn-outline-warning" onclick="toggleStatus(${user.userID}, '${user.status}')">Toggle</button>
                    </div>
                </td>
            </tr>`;
    });
}

function getStatusClass(status) {
    if (status === 'active') return 'bg-success';
    if (status === 'suspended') return 'bg-warning text-dark';
    return 'bg-danger';
}

// Handle Add User Form
document.getElementById('addUserForm').onsubmit = async (e) => {
    e.preventDefault();
    const formData = new FormData();
    formData.append('username', document.getElementById('newUsername').value);
    formData.append('email', document.getElementById('newEmail').value);
    formData.append('password', document.getElementById('newPassword').value);
    formData.append('role', document.getElementById('newRole').value);
    formData.append('status', document.getElementById('newStatus').value);

    const res = await fetch('/api/users/add', { method: 'POST', body: formData });
    if (res.ok) {
        location.reload(); // Refresh table
    } else {
        alert("Error adding user");
    }
};
		</script>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
